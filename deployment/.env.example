# Values are local-only. npm run bootstrap generates signing keys and local identity.
# Never commit deployment/.env or paste a provider key into chat.

# Required for the selected Pi / GPT-6 Sol runtime; billable OpenAI API credential.
OPENAI_API_KEY=
# Administrator identity: exact-email:org_admin (generated from this deployment owner).
ADMIN_GRANTS=
# Exact comma-separated emails allowed by the sign-in broker.
AUTH_ALLOWED_EMAILS=
# Private Docker core URL used by sandbox capabilities.
PUBLIC_API_URL=

# Independent random signing/encryption keys, generated by bootstrap.
CAPABILITY_SECRET=
CONNECTOR_SECRET_KEY=
CORE_SIGNING_SECRET=
PORTAL_IDENTITY_SECRET=
SKILL_SIGNING_SECRET=
PORTAL_SESSION_SECRET=
AUTH_TOKEN_SECRET=
AUTH_CLIENT_SECRET=
# P-256 private JWK for the built-in authentication broker.
AUTH_SIGNING_JWK=

# Email login is disabled. Administrator login uses qm admin-login.
# ANTHROPIC_API_KEY=  # Optional alternative provider, not configured.
# RESEND_API_KEY=     # Optional future email login, not needed for administrator access.
