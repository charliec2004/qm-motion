+      try {
+        bytes = await tc.readBytes(path, signal);
+      } catch (e) {
+        signal?.throwIfAborted();
+        return fail(`could not transfer ${path} (${errMessage(e)}); the limit for transfer is 50 MB, so crop it first`);
+      }
+      signal?.throwIfAborted();
+      if (bytes === null)
+        return fail(
