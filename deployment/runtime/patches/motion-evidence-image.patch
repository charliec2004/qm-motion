+      const given = params.path.trim();
+      const fail = (error: string) =>
+        recordResult(callId, { tool: "motion_view", path: given, error }, text(`[motion_view error] ${error}`), true);
+      const path = given.startsWith("/root/workspace/") ? given.slice("/root/workspace/".length) : given;
+      const mimeType = MOTION_VIEW_TYPES[path.slice(path.lastIndexOf(".") + 1).toLowerCase()];
